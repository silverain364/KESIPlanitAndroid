<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 사진 -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32"/>
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />



    <application
            android:name=".PlanItApp"
            android:usesCleartextTraffic="true"
            android:allowBackup="true"
            android:dataExtractionRules="@xml/data_extraction_rules"
            android:fullBackupContent="@xml/backup_rules"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:supportsRtl="true"
            android:theme="@style/Theme.KESI"
            tools:targetApi="34">
        <activity
                android:name=".ui.community.chat.ChatActivity"
                android:exported="true"
            android:windowSoftInputMode="adjustPan">
        </activity>
        <activity
                android:name=".ui.community.AddGroupActivity"
                android:exported="true">
        </activity>
        <activity
                android:name=".ui.community.AddFriendsActivity"
                android:exported="true">
        </activity>
        <activity
                android:name=".ui.community.location.LocationSharingActivity"
                android:exported="true">
        </activity>
        <activity
                android:name=".ui.home.ScheduleInformationActivity"
                android:exported="true">
        </activity>
        <activity
                android:name=".ui.community.chat.AddGroupScheduleActivity"
                android:exported="true">
        </activity>
        <activity
                android:name=".ui.home.AddScheduleActivity"
                android:exported="true">
        </activity>
        <activity
                android:name=".ui.login.ProfileSettingsActivity"
                android:exported="true">
        </activity>
        <activity
                android:name=".ui.login.SignUpActivity"
                android:exported="true">
        </activity>
        <activity
                android:name=".ui.login.LoginActivity"
                android:exported="true">
        </activity>
        <activity
            android:name=".ui.home.EditScheduleActivity"
            android:exported="true">
        </activity>

        <activity
                android:name=".ui.login.SplashActivity"
                android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>

                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <activity
                android:name=".ui.main.MainActivity"
                android:exported="true"
                android:windowSoftInputMode="adjustPan">
        </activity>
        <service android:name=".application.MessagingService"
                 android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MESSAGING_EVENT"/>
            </intent-filter>
        </service>
    </application>

</manifest>